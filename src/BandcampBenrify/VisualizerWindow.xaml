<Window x:Class="BandcampBenrify.VisualizerWindow"
        Icon="/Assets/app.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="clr-namespace:BandcampBenrify.Infrastructure"
        Title="ビジュアライザ - Bandcamp Benrify"
        Width="1280" Height="760" MinWidth="480" MinHeight="300"
        FontFamily="Yu Gothic UI, Segoe UI" FontSize="13"
        Background="#0B0B0D" Foreground="White"
        WindowStartupLocation="Manual">
    <Window.InputBindings>
        <KeyBinding Key="Space" Command="{Binding PlayPauseCommand}" />
        <KeyBinding Key="Space" Modifiers="Ctrl" Command="{Binding PlayPauseCommand}" />
        <KeyBinding Key="Right" Modifiers="Ctrl" Command="{Binding NextCommand}" />
        <KeyBinding Key="Left" Modifiers="Ctrl" Command="{Binding PreviousCommand}" />
        <KeyBinding Key="D" Modifiers="Ctrl" Command="{Binding CheckCurrentAndNextCommand}" />
        <KeyBinding Key="M" Modifiers="Ctrl" Command="{Binding ToggleMuteCommand}" />
    </Window.InputBindings>

    <Grid x:Name="Root" Background="#0B0B0D" MouseMove="Root_MouseMove" MouseLeftButtonDown="Root_MouseLeftButtonDown">
        <!-- 背景: ジャケットをぼかして暗くしたもの (動かさない) -->
        <Image x:Name="BackgroundArt" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="-120">
            <Image.Effect>
                <BlurEffect Radius="90" KernelType="Gaussian" RenderingBias="Performance" />
            </Image.Effect>
        </Image>
        <Rectangle Fill="#B80B0B0D" />

        <!-- 高さ 780 で組んで、ウィンドウの大きさに合わせて拡大縮小する (幅はウィンドウの縦横比に合わせてコードで決める) -->
        <Viewbox Stretch="Uniform">
            <Grid x:Name="Stage" Width="1280" Height="780">
                <!-- ジャケットと周りの音の輪。画面のちょうど中央に置き、下の曲情報・波形にジャケットがかからない一番大きな大きさまで
                     拡大縮小する (ArtScale はコードで決める)。輪は一番伸びてもこの 500x500 に収まる。輪が曲名に重なるのはかまわない。
                     ちょうど中央だと下がって見えるので、下の余白で中心を 24 だけ上げる (大きさは中央に置いたときのまま) -->
                <Grid x:Name="ArtStage" Width="500" Height="500" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,48" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <ScaleTransform x:Name="ArtScale" />
                    </Grid.RenderTransform>
                    <infra:SpectrumRing x:Name="Ring" InnerRadius="166" MaxLength="66" BarThickness="7" />
                    <!-- ジャケットは丸く切り抜き、再生中はゆっくり回す (ArtRotate はコードで回す) -->
                    <Border x:Name="ArtFrame" Width="310" Height="310" CornerRadius="155" Background="#22FFFFFF" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <RotateTransform x:Name="ArtRotate" />
                        </Border.RenderTransform>
                        <Border.Clip>
                            <EllipseGeometry Center="155,155" RadiusX="155" RadiusY="155" />
                        </Border.Clip>
                        <!-- 少し拡大してから切り抜く。レコード盤の絵のジャケットは盤が正方形より少し小さく、そのままだと縁の余白が細い輪になって残るため
                             (いろいろなレーベルのジャケットで比べて、余白が消えて端の文字は欠けない 1.08 にした) -->
                        <Image x:Name="ArtImage" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" RenderTransformOrigin="0.5,0.5">
                            <Image.RenderTransform>
                                <ScaleTransform ScaleX="1.08" ScaleY="1.08" />
                            </Image.RenderTransform>
                        </Image>
                    </Border>
                </Grid>

                <StackPanel x:Name="BottomPanel" VerticalAlignment="Bottom">
                    <!-- 曲の情報 (左) と数字 (右) -->
                    <Grid Margin="56,0,56,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Bottom">
                            <TextBlock x:Name="TitleText" FontSize="40" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="SubText" FontSize="22" Opacity="0.82" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="LabelText" FontSize="17" Opacity="0.55" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="32,0,0,4">
                            <StackPanel x:Name="BpmStat" Margin="0,0,44,0" Visibility="Collapsed">
                                <TextBlock x:Name="BpmText" FontSize="40" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                <TextBlock Text="BPM" FontSize="15" Opacity="0.55" HorizontalAlignment="Right" />
                            </StackPanel>
                            <StackPanel x:Name="SupportersStat" Visibility="Collapsed">
                                <TextBlock x:Name="SupportersText" FontSize="40" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                <TextBlock Text="Supporters" FontSize="15" Opacity="0.55" HorizontalAlignment="Right" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- 波形 (再生済みの部分はジャケットの色)。クリック・ドラッグでシーク -->
                    <infra:WaveformView x:Name="Wave" Height="56" Margin="56,4,56,0" RestBrush="#4DFFFFFF" PlayedBrush="White"
                                        Cursor="Hand" ToolTip="クリック / ドラッグで再生位置を移動"
                                        MouseLeftButtonDown="Wave_MouseLeftButtonDown" MouseMove="Wave_MouseMove" MouseLeftButtonUp="Wave_MouseLeftButtonUp"
                                        LostMouseCapture="Wave_LostMouseCapture" />
                    <Grid Margin="56,4,56,20">
                        <TextBlock x:Name="PositionText" FontSize="15" Opacity="0.6" HorizontalAlignment="Left" />
                        <TextBlock x:Name="DurationText" FontSize="15" Opacity="0.6" HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>
            </Grid>
        </Viewbox>

        <TextBlock x:Name="IdleText" Text="再生していません" FontSize="20" Opacity="0.6" HorizontalAlignment="Center" VerticalAlignment="Center" />

        <!-- 操作 (マウスを動かしたときだけ出す) -->
        <Border x:Name="Controls" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16" Padding="10,6" CornerRadius="24"
                Background="#CC17191C" Opacity="0" IsHitTestVisible="False">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource IconButton}" Content="&#xE892;" FontSize="18" Command="{Binding PreviousCommand}" ToolTip="前へ (Ctrl+←)" AutomationProperties.Name="前へ" />
                <Button x:Name="VisPlayButton" Style="{StaticResource PlayButton}" Content="{Binding PlayPauseGlyph}" Command="{Binding PlayPauseCommand}" ToolTip="再生 / 一時停止 (Space)" AutomationProperties.Name="再生 / 一時停止" />
                <Button Style="{StaticResource IconButton}" Content="&#xE893;" FontSize="18" Command="{Binding NextCommand}" ToolTip="次へ (Ctrl+→)" AutomationProperties.Name="次へ" />
                <Button Style="{StaticResource PillButton}" Padding="16,8" Margin="10,0,6,0" VerticalAlignment="Center" Command="{Binding CheckCurrentAndNextCommand}"
                        ToolTip="今の曲をチェック済みにして次の曲へ (Ctrl+D)" AutomationProperties.Name="チェックして次へ">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE73E;" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="14" />
                        <TextBlock Text="チェックして次へ" FontSize="14" />
                    </StackPanel>
                </Button>
                <Button x:Name="VisMuteButton" Style="{StaticResource IconButton}" Content="{Binding VolumeGlyph}" Margin="8,0,2,0"
                        Command="{Binding ToggleMuteCommand}" ToolTip="{Binding MuteToolTip}" AutomationProperties.Name="消音" />
                <Slider x:Name="VisVolumeSlider" Width="100" Minimum="0" Maximum="1" Value="{Binding Volume}" VerticalAlignment="Center" Margin="0,0,12,0"
                        Style="{StaticResource PlayerSlider}" IsMoveToPointEnabled="True" ToolTip="音量" AutomationProperties.Name="音量" />
                <Button x:Name="FullScreenButton" Style="{StaticResource IconButton}" Content="&#xE740;" Click="FullScreen_Click" ToolTip="全画面 (F11 / ダブルクリック)" AutomationProperties.Name="全画面" />
                <Button Style="{StaticResource IconButton}" Content="&#xE711;" Click="Close_Click" ToolTip="閉じる (Esc)" AutomationProperties.Name="閉じる" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
