<Window x:Class="BandcampBenrify.MainWindow"
        Icon="/Assets/app.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:BandcampBenrify.ViewModels"
        xmlns:infra="clr-namespace:BandcampBenrify.Infrastructure"
        Title="{Binding WindowTitle}"
        Width="1600" Height="960" MinWidth="960" MinHeight="560"
        FontFamily="Yu Gothic UI, Segoe UI" FontSize="13"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="Manual">
    <Window.InputBindings>
        <KeyBinding Key="Space" Modifiers="Ctrl" Command="{Binding PlayPauseCommand}" />
        <KeyBinding Key="Right" Modifiers="Ctrl" Command="{Binding NextCommand}" />
        <KeyBinding Key="Left" Modifiers="Ctrl" Command="{Binding PreviousCommand}" />
        <KeyBinding Key="D" Modifiers="Ctrl" Command="{Binding CheckCurrentAndNextCommand}" />
        <KeyBinding Key="M" Modifiers="Ctrl" Command="{Binding ToggleMuteCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <infra:SupporterBarWidthConverter x:Key="SupBarWidth" />

        <!-- 一覧 (キュー・作品・曲目) 共通。Windows 11 テーマの部品を土台にする (App.xaml では土台が読めないのでここに置く) -->
        <Style x:Key="ListGrid" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="GridLinesVisibility" Value="None" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="RowHeight" Value="32" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="ListHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="6,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource MutedText}" />
        </Style>
        <!-- 行とセルは Windows 11 テーマのものだとマウスを乗せたときなどに白くなるので、見た目を自前で決める -->
        <Style x:Key="ListCell" TargetType="DataGridCell">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <!--
                文字色は行 (再生中・チェック済みなど) に合わせる。
                これが無いと、Windows 標準のセルの決まりで、選択中は白、ウィンドウが非アクティブのときは黒になってしまう。
            -->
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridRow}}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ListRow" TargetType="DataGridRow">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridRow">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" SnapsToDevicePixels="True">
                            <SelectiveScrollingGrid>
                                <SelectiveScrollingGrid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </SelectiveScrollingGrid.ColumnDefinitions>
                                <SelectiveScrollingGrid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </SelectiveScrollingGrid.RowDefinitions>
                                <DataGridCellsPresenter Grid.Column="1" ItemsPanel="{TemplateBinding ItemsPanel}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                <DataGridDetailsPresenter Grid.Column="1" Grid.Row="1" Visibility="{TemplateBinding DetailsVisibility}"
                                                          SelectiveScrollingGrid.SelectiveScrollingOrientation="{Binding AreRowDetailsFrozen, ConverterParameter={x:Static SelectiveScrollingOrientation.Vertical}, Converter={x:Static DataGrid.RowDetailsScrollingConverter}, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" />
                                <DataGridRowHeader Grid.RowSpan="2" SelectiveScrollingGrid.SelectiveScrollingOrientation="Vertical"
                                                   Visibility="{Binding HeadersVisibility, ConverterParameter={x:Static DataGridHeadersVisibility.Row}, Converter={x:Static DataGrid.HeadersVisibilityConverter}, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" />
                            </SelectiveScrollingGrid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <!--
                マウス・選択も DataTrigger で書く。WPF では普通の Trigger が DataTrigger より常に優先されるので、
                Trigger で書くと「再生中」(DataTrigger) の色が選択中の行で消えてしまう。DataTrigger 同士なら後に書いたもの (再生中) が勝つ。
            -->
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Background" Value="{StaticResource HoverBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Background" Value="{StaticResource SelectedBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NumCell" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="4,0,10,0" />
        </Style>
        <!-- 曲名以外の文字は少し控えめに (行ごと暗くしたときも一緒に暗くなるよう Opacity で) -->
        <Style x:Key="SubCell" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
            <Setter Property="Opacity" Value="0.85" />
        </Style>
        <Style x:Key="SubNumCell" TargetType="TextBlock" BasedOn="{StaticResource NumCell}">
            <Setter Property="Opacity" Value="0.85" />
        </Style>
        <Style x:Key="SeqCell" TargetType="TextBlock" BasedOn="{StaticResource NumCell}">
            <Setter Property="Opacity" Value="0.7" />
        </Style>
        <Style x:Key="TotalCell" TargetType="TextBlock" BasedOn="{StaticResource NumCell}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding TotalIsPartial}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource MutedText}" />
                    <Setter Property="FontWeight" Value="Normal" />
                    <Setter Property="ToolTip" Value="曲単体のサポーター数が未取得のため、アルバム分だけの数です" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PurchaseCell" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
            <Setter Property="Foreground" Value="{StaticResource PurchasedBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <!-- 「チェック済み」のチェックボックス (キュー・探す の曲目 共通) -->
        <DataTemplate x:Key="CheckedCellTemplate" DataType="vm:QueueItemViewModel">
            <CheckBox IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center"
                      MinWidth="0" Padding="0" Focusable="False" AutomationProperties.Name="チェック済み"
                      ToolTip="チェック済みの印 (このアプリにだけ記録されます。キューから削除しても残ります)" />
        </DataTemplate>
        <!-- 曲の行 (キュー・探す の曲目): 再生中はアクセント色、チェック済み・購入済みは暗く -->
        <Style x:Key="TrackRow" TargetType="DataGridRow" BasedOn="{StaticResource ListRow}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPurchased}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource MutedText}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsChecked}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource DimRowBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- URL / キーワード入力 -->
        <Grid DockPanel.Dock="Top" Margin="16,14,16,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid>
                <TextBox x:Name="UrlBox" Text="{Binding InputUrl, UpdateSourceTrigger=PropertyChanged}"
                         VerticalContentAlignment="Center" Padding="12,7" FontSize="14">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding OpenInBrowseCommand}" />
                        <KeyBinding Key="Enter" Modifiers="Ctrl" Command="{Binding AddUrlCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <TextBlock Text="Bandcamp の URL (レーベル・アーティスト・アルバム・曲) — Enter で「探す」、Ctrl+Enter でそのままキューへ (キーワードならブラウザで検索)" Margin="15,0,0,0"
                           VerticalAlignment="Center" Foreground="{StaticResource DimTextBrush}" IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=UrlBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
            <Button x:Name="BrowseButton" Grid.Column="1" Content="探す" Command="{Binding OpenInBrowseCommand}" Style="{StaticResource AccentPillButton}" Padding="20,6" Margin="10,0,0,0"
                    ToolTip="「探す」タブで作品一覧や検索結果を表示して、曲を選んでキューに入れます (Enter)" />
            <Button Grid.Column="2" Content="キューに追加" Command="{Binding AddUrlCommand}" Style="{StaticResource PillButton}"
                    ToolTip="URL の曲・アルバムの全曲・レーベルの全作品の全曲を、選ばずにそのままキューへ (Ctrl+Enter)" />
            <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="18,0,0,0">
                <TextBlock Text="{Binding CollectionStatus}" VerticalAlignment="Center" Foreground="{StaticResource MutedText}" FontSize="12" />
                <Button x:Name="RefreshCollectionButton" Content="コレクション更新" Command="{Binding RefreshCollectionCommand}" Style="{StaticResource PillButton}" Margin="10,0,0,0"
                        ToolTip="Bandcamp の公開コレクションを読み込み直して、購入済みの印を更新します" />
                <Button x:Name="SettingsButton" Click="Settings_Click" Style="{StaticResource PillButton}" ToolTip="設定 (テーマカラー・プロフィール・リクエスト間隔・キャッシュ)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE713;" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="設定" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ステータスバー -->
        <Border DockPanel.Dock="Bottom" Background="#0E1013" Padding="16,4">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding RequestStatus}" Foreground="{StaticResource DimTextBrush}" FontSize="12" Margin="16,0,0,0" />
                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource MutedText}" FontSize="12" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <!-- プレイヤー (ジャケットの色は MainWindow.xaml.cs で入れる) -->
        <Border x:Name="PlayerBar" DockPanel.Dock="Bottom" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- 左右を同じ幅にして、操作と波形がウィンドウの中央に来るようにする -->
                    <ColumnDefinition Width="*" MinWidth="320" />
                    <ColumnDefinition Width="2*" MinWidth="480" />
                    <ColumnDefinition Width="*" MinWidth="320" />
                </Grid.ColumnDefinitions>

                <!-- 曲の情報 -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="120" Height="120" Background="{StaticResource ArtPlaceholder}" CornerRadius="6">
                        <Border.Clip>
                            <RectangleGeometry Rect="0,0,120,120" RadiusX="6" RadiusY="6" />
                        </Border.Clip>
                        <Image x:Name="NowArtImage" Source="{Binding NowArtUrl, TargetNullValue={x:Null}}" Stretch="UniformToFill" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="18,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding NowTitle}" FontWeight="SemiBold" FontSize="19" Foreground="White" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding NowSubtitle}" Foreground="{StaticResource SubTextBrush}" FontSize="14" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding NowStats}" Foreground="{StaticResource MutedText}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,6,0,0" />
                        <TextBlock Margin="0,6,0,0" FontSize="12" Visibility="{Binding HasCurrent, Converter={StaticResource BoolToVis}}">
                            <Hyperlink Command="{Binding OpenInBrowserCommand}" Foreground="{DynamicResource AccentBrush}" TextDecorations="{x:Null}">Bandcamp で開く</Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </Grid>

                <!-- 操作とシークバー -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
                    <!-- ボタンは中央、推定 BPM は同じ行の右端 (波形の右端にそろえる)。重ねて置くのでボタンの中央はずれない -->
                    <Grid>
                    <Border HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,62,0" Padding="12,4" CornerRadius="12"
                            Background="#1AFFFFFF" ToolTip="{Binding NowBpmToolTip}"
                            Visibility="{Binding HasNowBpmText, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding NowBpmText}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                    </Border>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <ToggleButton x:Name="ShuffleToggle" AutomationProperties.Name="ランダム再生" Style="{StaticResource IconToggle}" Content="&#xE8B1;" IsChecked="{Binding Shuffle}"
                                      ToolTip="オン: キュー全体からランダム / オフ: 表示の順番 (並び替えた順) に上から再生" />
                        <Button x:Name="PrevButton" AutomationProperties.Name="前へ" Style="{StaticResource IconButton}" Content="&#xE892;" FontSize="18" Command="{Binding PreviousCommand}" ToolTip="前へ (Ctrl+←)" />
                        <Button x:Name="PlayButton" AutomationProperties.Name="再生 / 一時停止" Style="{StaticResource PlayButton}" Content="{Binding PlayPauseGlyph}"
                                Command="{Binding PlayPauseCommand}" ToolTip="再生 / 一時停止 (Ctrl+Space)" />
                        <Button x:Name="NextButton" AutomationProperties.Name="次へ" Style="{StaticResource IconButton}" Content="&#xE893;" FontSize="18" Command="{Binding NextCommand}" ToolTip="次へ (Ctrl+→)" />
                        <ToggleButton x:Name="RepeatOneToggle" AutomationProperties.Name="1曲リピート" Style="{StaticResource IconToggle}" Content="&#xE8ED;" IsChecked="{Binding RepeatOne}"
                                      ToolTip="1 曲リピート: 今の曲を繰り返し再生します (「次へ」で次の曲に進めます)" />
                    </StackPanel>
                    </Grid>
                    <!-- 左右の欄は同じ幅 (波形がボタンの真下に来る) -->
                    <Grid Margin="0,6,0,0" Grid.IsSharedSizeScope="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="SeekSide" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="SeekSide" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding PositionText}" VerticalAlignment="Center" Foreground="{StaticResource MutedText}" FontSize="12" MinWidth="52" TextAlignment="Right" />
                        <!-- 波形 (再生した曲を解析して描く。解析前は普通のシークバーの見た目) と、その上に重ねた透明なシークバー -->
                        <infra:WaveformView x:Name="Waveform" Grid.Column="1" Margin="10,0" Height="36"
                                            Peaks="{Binding NowPeaks}" Duration="{Binding Duration}" Position="{Binding Value, ElementName=SeekBar}"
                                            PlayedBrush="{DynamicResource AccentBrush}" RestBrush="#4DFFFFFF">
                            <infra:WaveformView.Style>
                                <Style TargetType="infra:WaveformView">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasCurrent}" Value="False">
                                            <Setter Property="Opacity" Value="0.4" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </infra:WaveformView.Style>
                        </infra:WaveformView>
                        <Slider x:Name="SeekBar" AutomationProperties.Name="再生位置" Grid.Column="1" Margin="5,0" Height="36" Style="{StaticResource WaveSlider}"
                                IsEnabled="{Binding HasCurrent}"
                                Minimum="0" Maximum="{Binding SeekMaximum}" Value="{Binding Position, Mode=OneWay}"
                                IsMoveToPointEnabled="True"
                                Thumb.DragStarted="SeekBar_DragStarted" Thumb.DragCompleted="SeekBar_DragCompleted"
                                PreviewMouseLeftButtonUp="SeekBar_MouseUp" />
                        <TextBlock Grid.Column="2" Text="{Binding DurationText}" VerticalAlignment="Center" Foreground="{StaticResource MutedText}" FontSize="12" MinWidth="52" />
                    </Grid>
                </StackPanel>

                <!-- チェックして次へ・音量 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="CheckNextButton" AutomationProperties.Name="チェックして次へ" Style="{StaticResource PillButton}" Padding="22,11" VerticalAlignment="Center"
                            Command="{Binding CheckCurrentAndNextCommand}" ToolTip="今の曲をチェック済みにして次の曲へ (Ctrl+D)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE73E;" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="15" />
                            <TextBlock Text="チェックして次へ" FontSize="15" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="MuteButton" AutomationProperties.Name="消音" Style="{StaticResource IconButton}" Content="{Binding VolumeGlyph}" Margin="20,0,4,0"
                            Command="{Binding ToggleMuteCommand}" ToolTip="{Binding MuteToolTip}" />
                    <Slider x:Name="VolumeSlider" AutomationProperties.Name="音量" Width="110" Minimum="0" Maximum="1" Value="{Binding Volume}" VerticalAlignment="Center" ToolTip="音量"
                            Style="{StaticResource PlayerSlider}" IsMoveToPointEnabled="True" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- バックグラウンド処理の進捗 -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource JobBackground}" Padding="16,6"
                Visibility="{Binding HasJobs, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="中止" Command="{Binding CancelJobsCommand}" Style="{StaticResource PillButton}" Padding="12,2" />
                <ProgressBar DockPanel.Dock="Right" Width="200" Height="6" Margin="12,0" Maximum="1"
                             Value="{Binding JobProgress, Mode=OneWay}" IsIndeterminate="{Binding JobProgressIndeterminate, Mode=OneWay}" />
                <TextBlock Text="{Binding JobText}" VerticalAlignment="Center" Foreground="{StaticResource JobText}" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <TabControl x:Name="MainTabs" SelectedIndex="{Binding SelectedTab}" Margin="16,0,16,8" Style="{StaticResource UnderlineTabs}">
            <!-- 探す -->
            <TabItem Header="探す" DataContext="{Binding Browse}">
                <DockPanel Margin="0,10,0,0">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" LastChildFill="False">
                        <Button x:Name="BackButton" Command="{Binding BackCommand}" Style="{StaticResource PillButton}" Margin="0" Padding="10,4" ToolTip="前に開いていた一覧に戻る">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE72B;" />
                        </Button>
                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,0,0" />
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button x:Name="LoadMoreFanButton" Content="{Binding LoadMoreFanText}" Command="{Binding LoadMoreFanCommand}" Style="{StaticResource PillButton}" Margin="0,0,8,0"
                                    Visibility="{Binding HasMoreFanItems, Converter={StaticResource BoolToVis}}"
                                    ToolTip="コレクション / ウィッシュリストの続きを読み込みます (20 件ごとに 1 リクエスト、1 回で最大 200 件)。" />
                            <Button x:Name="FetchReleaseInfoButton" Content="{Binding ReleaseInfoButtonText}" Command="{Binding FetchReleaseInfoCommand}" Style="{StaticResource PillButton}"
                                    ToolTip="一覧 (絞り込み後) の作品ページを取得して、サポーター数・値段・リリース日を表示します (1 作品 1 リクエスト)。サポーターが「N+」の作品は、続けて正確な人数を数えます (100 人ごとに 1 リクエスト)。" />
                            <TextBlock Text="絞り込み" VerticalAlignment="Center" Margin="16,0,8,0" Foreground="{StaticResource MutedText}" />
                            <TextBox x:Name="BrowseFilterBox" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" Width="180" Padding="8,4" VerticalContentAlignment="Center"
                                     ToolTip="タイトル・アーティストで一覧を絞り込みます (Bandcamp には問い合わせません)" />
                            <CheckBox Content="購入済みを隠す" IsChecked="{Binding HidePurchased}" Style="{StaticResource ChipCheckBox}" Margin="12,0,0,0" />
                            <CheckBox Content="チェック済みを隠す" IsChecked="{Binding HideChecked}" Style="{StaticResource ChipCheckBox}"
                                      ToolTip="全曲チェック済みの作品を一覧から隠します" />
                        </StackPanel>
                    </DockPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" MinWidth="360" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="2*" MinWidth="360" />
                        </Grid.ColumnDefinitions>

                        <!-- 作品一覧 -->
                        <DockPanel>
                            <Grid>
                                <DataGrid x:Name="ReleaseGrid" ItemsSource="{Binding ItemsView}" SelectedItem="{Binding SelectedItem}"
                                          Style="{StaticResource ListGrid}" ColumnHeaderStyle="{StaticResource ListHeader}" CellStyle="{StaticResource ListCell}"
                                          AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" RowHeight="50"
                                          EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                          Sorting="Grid_Sorting" MouseDoubleClick="ReleaseGrid_MouseDoubleClick" PreviewKeyDown="ReleaseGrid_PreviewKeyDown">
                                    <DataGrid.RowStyle>
                                        <Style TargetType="DataGridRow" BasedOn="{StaticResource ListRow}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPurchased}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource MutedText}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsAllChecked}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource DimRowBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.RowStyle>
                                    <DataGrid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="選択した作品の全曲をキューに追加" Command="{Binding PlacementTarget.DataContext.AddReleasesCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <MenuItem Header="アーティスト / レーベルを開く" Command="{Binding PlacementTarget.DataContext.OpenItemCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <MenuItem Header="Bandcamp で開く" Command="{Binding PlacementTarget.DataContext.OpenInBrowserCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        </ContextMenu>
                                    </DataGrid.ContextMenu>
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Width="52" CanUserSort="False">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate DataType="vm:BrowseItemViewModel">
                                                    <Border Width="40" Height="40" Background="{StaticResource ArtPlaceholder}" CornerRadius="3">
                                                        <Border.Clip>
                                                            <RectangleGeometry Rect="0,0,40,40" RadiusX="3" RadiusY="3" />
                                                        </Border.Clip>
                                                        <Image Source="{Binding ArtUrl, TargetNullValue={x:Null}}" Stretch="UniformToFill" />
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="種類" Binding="{Binding KindLabel}" Width="70" ElementStyle="{StaticResource SubCell}" />
                                        <DataGridTextColumn Header="購入済み" Binding="{Binding PurchaseText}" Width="86" ElementStyle="{StaticResource PurchaseCell}" />
                                        <DataGridTextColumn Header="チェック" Binding="{Binding CheckedText}" SortMemberPath="CheckedTracks" Width="70" ElementStyle="{StaticResource SubCell}" />
                                        <DataGridTextColumn Header="タイトル" Binding="{Binding Title}" Width="2*" MinWidth="120" ElementStyle="{StaticResource CellText}" />
                                        <DataGridTextColumn Header="アーティスト" Binding="{Binding Artist}" Width="*" MinWidth="80" ElementStyle="{StaticResource SubCell}" />
                                        <DataGridTextColumn Header="レーベル" Binding="{Binding Label}" Width="0.8*" MinWidth="70" ElementStyle="{StaticResource SubCell}" />
                                        <DataGridTextColumn Header="サポーター" Binding="{Binding SupText}" SortMemberPath="SupSort" Width="80" ElementStyle="{StaticResource TotalCell}" />
                                        <DataGridTextColumn Header="値段" Binding="{Binding PriceText}" SortMemberPath="PriceSort" Width="70" ElementStyle="{StaticResource NumCell}" />
                                        <DataGridTextColumn Header="リリース日" Binding="{Binding ReleaseDateText}" SortMemberPath="ReleaseDate" Width="90" ElementStyle="{StaticResource SubCell}" />
                                        <DataGridTextColumn Header="曲数" Binding="{Binding TrackCount}" Width="50" ElementStyle="{StaticResource SubNumCell}" />
                                        <DataGridTextColumn Header="状態" Binding="{Binding StateText}" Width="80" ElementStyle="{StaticResource SubCell}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE721;" FontSize="32" HorizontalAlignment="Center" Foreground="{StaticResource DimTextBrush}" />
                                    <TextBlock Text="作品を探す" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{StaticResource SubTextBrush}" Margin="0,12,0,0" />
                                    <TextBlock Margin="0,10,0,0" Foreground="{StaticResource MutedText}" TextAlignment="Center" LineHeight="24">
                                        上の欄にレーベル・アーティスト・アルバムの URL を入れて Enter、<LineBreak />
                                        または Chrome 拡張の「Benrify の「探す」で開く」で作品一覧を表示します<LineBreak />
                                        作品を選ぶと右に曲目が出ます。ダブルクリックで試聴、選んでキューに追加。
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </DockPanel>

                        <GridSplitter Grid.Column="1" Width="12" HorizontalAlignment="Stretch" Background="Transparent">
                            <GridSplitter.Template>
                                <ControlTemplate TargetType="GridSplitter">
                                    <Border Background="Transparent" />
                                </ControlTemplate>
                            </GridSplitter.Template>
                        </GridSplitter>

                        <!-- 選んだ作品の曲目 -->
                        <DockPanel Grid.Column="2">
                            <Grid DockPanel.Dock="Top" Margin="4,0,0,10" Visibility="{Binding HasSelectedRelease, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="112" Height="112" Background="{StaticResource ArtPlaceholder}" CornerRadius="4">
                                    <Border.Clip>
                                        <RectangleGeometry Rect="0,0,112,112" RadiusX="4" RadiusY="4" />
                                    </Border.Clip>
                                    <Image Source="{Binding SelectedArtUrl, TargetNullValue={x:Null}}" Stretch="UniformToFill" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedItem.Title}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="White" />
                                    <TextBlock Text="{Binding SelectedItem.Artist}" Foreground="{StaticResource SubTextBrush}" Margin="0,2,0,0" />
                                    <TextBlock Text="{Binding SelectedSummary}" Foreground="{StaticResource MutedText}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
                                    <WrapPanel Margin="0,10,0,0">
                                        <Button x:Name="AddReleaseButton" Content="この作品の全曲をキューに追加" Command="{Binding AddCurrentReleaseCommand}" Style="{StaticResource PillButton}" Margin="0,0,6,0" />
                                        <Button Content="Bandcamp で開く" Command="{Binding OpenInBrowserCommand}" Style="{StaticResource PillButton}" Margin="0" />
                                    </WrapPanel>
                                </StackPanel>
                            </Grid>
                            <WrapPanel DockPanel.Dock="Top" Margin="4,0,0,6" Visibility="{Binding HasSelectedRelease, Converter={StaticResource BoolToVis}}">
                                <Button x:Name="AddTracksButton" Content="選択した曲をキューに追加" Command="{Binding AddTracksCommand}" CommandParameter="{Binding SelectedItems, ElementName=TrackGrid}" Style="{StaticResource PillButton}" Margin="0,0,6,0" />
                                <Button x:Name="FetchTrackInfoButton" Content="曲の情報を取得" Command="{Binding FetchTrackInfoCommand}" CommandParameter="{Binding SelectedItems, ElementName=TrackGrid}" Style="{StaticResource PillButton}" Margin="0"
                                        ToolTip="曲ページを取得して、曲単体のサポーター数と値段を表示します (1 曲 1 リクエスト)。選択があれば選択した曲だけ。" />
                                <TextBlock Text="ダブルクリックで試聴 (キューには入りません)" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{StaticResource MutedText}" FontSize="12" />
                            </WrapPanel>
                            <DataGrid x:Name="TrackGrid" Margin="4,0,0,0" ItemsSource="{Binding Tracks}" AutoGenerateColumns="False" IsReadOnly="True"
                                      Style="{StaticResource ListGrid}" ColumnHeaderStyle="{StaticResource ListHeader}" CellStyle="{StaticResource ListCell}"
                                      SelectionMode="Extended"
                                      Sorting="Grid_Sorting" MouseDoubleClick="TrackGrid_MouseDoubleClick" PreviewKeyDown="TrackGrid_PreviewKeyDown"
                                      Visibility="{Binding HasSelectedRelease, Converter={StaticResource BoolToVis}}">
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow" BasedOn="{StaticResource TrackRow}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsStreamable}" Value="False">
                                                <Setter Property="Foreground" Value="{StaticResource DimRowBrush}" />
                                                <Setter Property="ToolTip" Value="試聴が公開されていない曲です" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="試聴" Command="{Binding PlacementTarget.DataContext.PreviewCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <MenuItem Header="キューに追加" Command="{Binding PlacementTarget.DataContext.AddTracksCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <MenuItem Header="曲の情報を取得" Command="{Binding PlacementTarget.DataContext.FetchTrackInfoCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <MenuItem Header="チェック済みにする" Command="{Binding PlacementTarget.DataContext.CheckSelectedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <MenuItem Header="チェックを外す" Command="{Binding PlacementTarget.DataContext.UncheckSelectedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <MenuItem Header="Bandcamp で開く" Command="{Binding PlacementTarget.DataContext.OpenInBrowserCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Binding="{Binding Seq}" Width="36" ElementStyle="{StaticResource SeqCell}" />
                                    <DataGridTextColumn Header="キュー" Binding="{Binding QueuedText}" Width="52" ElementStyle="{StaticResource PurchaseCell}" />
                                    <DataGridTextColumn Header="タイトル" Binding="{Binding Title}" Width="*" MinWidth="120" ElementStyle="{StaticResource CellText}" />
                                    <DataGridTextColumn Header="購入済み" Binding="{Binding PurchaseText}" Width="80" ElementStyle="{StaticResource PurchaseCell}" />
                                    <DataGridTemplateColumn Header="チェック" CellTemplate="{StaticResource CheckedCellTemplate}" SortMemberPath="CheckedSort" Width="64" />
                                    <DataGridTextColumn Header="サポーター計" Binding="{Binding TotalText}" SortMemberPath="TotalSort" Width="86" ElementStyle="{StaticResource TotalCell}" />
                                    <DataGridTextColumn Header="うち曲単体" Binding="{Binding TrackSupText}" SortMemberPath="TrackSupSort" Width="72" ElementStyle="{StaticResource SubNumCell}" />
                                    <DataGridTextColumn Header="曲の値段" Binding="{Binding TrackPriceText}" SortMemberPath="TrackPriceSort" Width="72" ElementStyle="{StaticResource NumCell}" />
                                    <DataGridTextColumn Header="長さ" Binding="{Binding Duration}" SortMemberPath="DurationSeconds" Width="52" ElementStyle="{StaticResource SubNumCell}" />
                                    <DataGridTextColumn Binding="{Binding BpmText}" SortMemberPath="BpmSort" Width="52" ElementStyle="{StaticResource SubNumCell}">
                                        <DataGridTextColumn.Header>
                                            <TextBlock Text="BPM" ToolTip="再生したときに曲から推定した BPM (目安。倍や半分になっていることがあります)&#10;空欄: まだ再生していない曲 / 「—」: テンポがはっきりせず推定できなかった曲" />
                                        </DataGridTextColumn.Header>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Grid>
                </DockPanel>
            </TabItem>

            <!-- キュー -->
            <TabItem Header="{Binding QueueHeader}">
            <DockPanel Margin="0,10,0,0">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" LastChildFill="False">
                    <Button x:Name="FetchDetailsButton" Content="{Binding DetailsButtonText}" Margin="0" Style="{StaticResource PillButton}"
                            Command="{Binding FetchDetailsCommand}"
                            ToolTip="曲ページを取得して、曲単体のサポーター数と値段を調べます (1 曲 1 リクエスト)。&#10;表示中の曲を上から順にすべて取得します (選んだ曲だけ取得するときは右クリック)。" />
                    <CheckBox x:Name="HidePurchasedCheck" Content="購入済みを隠す" IsChecked="{Binding HidePurchased}" Style="{StaticResource ChipCheckBox}" Margin="14,0,0,0"
                              ToolTip="購入済みの曲を一覧と再生対象から外します (コレクションの読み込みが必要)" />
                    <CheckBox x:Name="HideCheckedCheck" Content="チェック済みを隠す" IsChecked="{Binding HideChecked}" Style="{StaticResource ChipCheckBox}"
                              ToolTip="チェック済みの曲を一覧と再生対象から外します" />
                    <TextBlock Text="{Binding QueueSummary}" VerticalAlignment="Center" Margin="14,0,0,0" Foreground="{StaticResource MutedText}" />
                    <Button DockPanel.Dock="Right" Command="{Binding ClearQueueCommand}" Style="{StaticResource PillButton}" AutomationProperties.Name="すべて削除"
                            ToolTip="キューの曲をすべて削除します (チェック済みの印は残ります)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE74D;" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12" />
                            <TextBlock Text="すべて削除" />
                        </StackPanel>
                    </Button>                </DockPanel>
                <Grid>
            <DataGrid x:Name="QueueGrid" ItemsSource="{Binding QueueView}" AutoGenerateColumns="False" IsReadOnly="True"
                      Style="{StaticResource ListGrid}" ColumnHeaderStyle="{StaticResource ListHeader}" CellStyle="{StaticResource ListCell}" RowStyle="{StaticResource TrackRow}"
                      SelectionMode="Extended" SelectionUnit="FullRow" CanUserReorderColumns="True" CanUserResizeColumns="True"
                      EnableRowVirtualization="True" EnableColumnVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                      Sorting="Grid_Sorting" MouseDoubleClick="QueueGrid_MouseDoubleClick" PreviewKeyDown="QueueGrid_PreviewKeyDown">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="再生" Command="{Binding PlacementTarget.DataContext.PlayItemCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="チェック済みにする" Command="{Binding PlacementTarget.DataContext.CheckSelectedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="チェックを外す" Command="{Binding PlacementTarget.DataContext.UncheckSelectedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="選択した曲の情報を取得 (サポーター数・値段)" Command="{Binding PlacementTarget.DataContext.FetchDetailsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <Separator />
                        <MenuItem Header="曲を Bandcamp で開く" Command="{Binding PlacementTarget.DataContext.OpenInBrowserCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="アルバムを Bandcamp で開く" Command="{Binding PlacementTarget.DataContext.OpenAlbumCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <Separator />
                        <MenuItem Header="削除" Command="{Binding PlacementTarget.DataContext.RemoveSelectedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="30" CanUserSort="False" CanUserResize="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="vm:QueueItemViewModel">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE767;" VerticalAlignment="Center" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource AccentBrush}"
                                           Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVis}}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="#" Binding="{Binding Seq}" Width="48" ElementStyle="{StaticResource SeqCell}" />
                    <DataGridTextColumn Header="購入済み" Binding="{Binding PurchaseText}" Width="86" ElementStyle="{StaticResource PurchaseCell}" />
                    <DataGridTemplateColumn Header="チェック" CellTemplate="{StaticResource CheckedCellTemplate}" SortMemberPath="CheckedSort" Width="64" />
                    <DataGridTextColumn Header="タイトル" Binding="{Binding Title}" Width="2*" MinWidth="160" ElementStyle="{StaticResource CellText}" />
                    <DataGridTextColumn Header="アーティスト" Binding="{Binding Artist}" Width="1.2*" MinWidth="100" ElementStyle="{StaticResource SubCell}" />
                    <DataGridTextColumn Header="アルバム" Binding="{Binding Album}" Width="1.5*" MinWidth="100" ElementStyle="{StaticResource SubCell}" />
                    <DataGridTextColumn Header="レーベル" Binding="{Binding Label}" Width="1*" MinWidth="80" ElementStyle="{StaticResource SubCell}" />
                    <DataGridTemplateColumn SortMemberPath="TotalSort" Width="116">
                        <DataGridTemplateColumn.Header>
                            <TextBlock Text="サポーター計" ToolTip="アルバムのサポーター + 曲単体のサポーター。&#10;「+」: ページに載りきらないほど多い / 「?」: 曲単体が未取得&#10;棒はキューの中での多さの目安です (多い方から 1 割に入る曲は最大の長さ)" />
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="vm:QueueItemViewModel">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding TotalText}" Style="{StaticResource TotalCell}" />
                                    <Border Height="4" CornerRadius="2" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,2,0"
                                            Background="{DynamicResource AccentBarBrush}">
                                        <Border.Width>
                                            <MultiBinding Converter="{StaticResource SupBarWidth}" ConverterParameter="44">
                                                <Binding Path="TotalSort" />
                                                <Binding Path="DataContext.QueueMaxSupporters" RelativeSource="{RelativeSource AncestorType=DataGrid}" />
                                            </MultiBinding>
                                        </Border.Width>
                                    </Border>
                                </DockPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Binding="{Binding AlbumSupText}" SortMemberPath="AlbumSupSort" Width="80" ElementStyle="{StaticResource SubNumCell}">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="うちアルバム" ToolTip="収録アルバムを買ったサポーター (— は単独リリースの曲)" />
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding TrackSupText}" SortMemberPath="TrackSupSort" Width="72" ElementStyle="{StaticResource SubNumCell}">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="うち曲単体" ToolTip="この曲を単品で買ったサポーター (… は未取得)" />
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="曲の値段" Binding="{Binding TrackPriceText}" SortMemberPath="TrackPriceSort" Width="76" ElementStyle="{StaticResource NumCell}" />
                    <DataGridTextColumn Header="アルバムの値段" Binding="{Binding AlbumPriceText}" SortMemberPath="AlbumPriceSort" Width="96" ElementStyle="{StaticResource NumCell}" />
                    <DataGridTextColumn Header="リリース日" Binding="{Binding ReleaseDateText}" SortMemberPath="ReleaseDate" Width="90" ElementStyle="{StaticResource SubCell}" />
                    <DataGridTextColumn Header="長さ" Binding="{Binding Duration}" SortMemberPath="DurationSeconds" Width="56" ElementStyle="{StaticResource SubNumCell}" />
                    <DataGridTextColumn Binding="{Binding BpmText}" SortMemberPath="BpmSort" Width="52" ElementStyle="{StaticResource SubNumCell}">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="BPM" ToolTip="再生したときに曲から推定した BPM (目安。倍や半分になっていることがあります)&#10;空欄: まだ再生していない曲 / 「—」: テンポがはっきりせず推定できなかった曲" />
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                        Visibility="{Binding IsQueueEmpty, Converter={StaticResource BoolToVis}}">
                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE90B;" FontSize="32" HorizontalAlignment="Center" Foreground="{StaticResource DimTextBrush}" />
                <TextBlock Text="キューは空です" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{StaticResource SubTextBrush}" Margin="0,12,0,0" />
                <TextBlock Margin="0,10,0,0" Foreground="{StaticResource MutedText}" TextAlignment="Center" LineHeight="24">
                    「探す」タブで作品や曲を選んで追加するか、URL を貼って「キューに追加」<LineBreak />
                    列の見出しをクリックするとサポーター数や値段で並び替えられます。<LineBreak />
                    ランダム再生をオフにすると、並べた順に上から再生します。
                </TextBlock>
            </StackPanel>
                </Grid>
            </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
