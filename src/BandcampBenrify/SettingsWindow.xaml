<Window x:Class="BandcampBenrify.SettingsWindow"
        Icon="/Assets/app.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="設定 - Bandcamp Benrify" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Yu Gothic UI, Segoe UI" FontSize="13">
    <StackPanel Margin="20">
        <TextBlock Text="Bandcamp のプロフィール" FontWeight="SemiBold" FontSize="14" />
        <TextBlock Text="購入済みマークに使います。自分のプロフィールページの URL (またはユーザー名) を入力してください。&#10;公開されているコレクションを読み込みます (非公開にしている作品は判定できません)。"
                   Foreground="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,6" />
        <TextBox x:Name="ProfileBox" Padding="5,4" AutomationProperties.Name="プロフィール" TextChanged="ProfileBox_TextChanged" />
        <TextBlock x:Name="ProfileHint" Margin="0,4,0,0" FontSize="12" Foreground="{StaticResource MutedText}" Text="例: https://bandcamp.com/ユーザー名" />

        <TextBlock Text="Bandcamp へのリクエスト間隔" FontWeight="SemiBold" FontSize="14" Margin="0,20,0,0" />
        <TextBlock Text="間隔を短くすると速くなりますが、Bandcamp への負荷が増えます。1 秒未満にはできません。"
                   Foreground="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,6" />
        <StackPanel Orientation="Horizontal">
            <TextBox x:Name="IntervalBox" Width="70" Padding="5,4" AutomationProperties.Name="リクエスト間隔" />
            <TextBlock Text="秒 (既定 2.5)" VerticalAlignment="Center" Margin="6,0,0,0" />
        </StackPanel>

        <TextBlock Text="キャッシュ" FontWeight="SemiBold" FontSize="14" Margin="0,20,0,0" />
        <DockPanel Margin="0,4,0,0">
            <Button x:Name="ClearCacheButton" DockPanel.Dock="Right" Content="キャッシュを削除" Click="ClearCache_Click" />
            <TextBlock x:Name="CacheText" VerticalAlignment="Center" Foreground="{StaticResource MutedText}" TextWrapping="Wrap" />
        </DockPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button x:Name="OkButton" Content="保存" IsDefault="True" Click="Ok_Click" MinWidth="90" />
            <Button Content="キャンセル" IsCancel="True" MinWidth="90" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
