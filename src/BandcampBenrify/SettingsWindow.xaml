<Window x:Class="BandcampBenrify.SettingsWindow"
        Icon="/Assets/app.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="設定 - Bandcamp Benrify" Width="580" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Yu Gothic UI, Segoe UI" FontSize="13">
    <Window.Resources>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Margin" Value="0,22,0,0" />
        </Style>
        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedText}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,8" />
        </Style>
        <!-- テーマカラーの色見本 (丸) -->
        <Style x:Key="Swatch" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Width="34" Height="34" Background="Transparent">
                            <Ellipse x:Name="Ring" Stroke="White" StrokeThickness="2" Visibility="Hidden" />
                            <Ellipse Width="24" Height="24" Fill="{TemplateBinding Background}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Ring" Property="Stroke" Value="#5B636C" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Ring" Property="Stroke" Value="White" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel Margin="24,8,24,20">
        <TextBlock Text="テーマカラー" Style="{StaticResource Heading}" />
        <StackPanel x:Name="SwatchPanel" Orientation="Horizontal" Margin="0,8,0,0" />
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <TextBlock Text="色コード" VerticalAlignment="Center" Foreground="{StaticResource SubTextBrush}" />
            <TextBox x:Name="ColorBox" Width="110" Padding="8,4" Margin="10,0,0,0" AutomationProperties.Name="テーマカラーの色コード" TextChanged="ColorBox_TextChanged" />
            <TextBlock x:Name="ColorHint" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="12" Foreground="{StaticResource MutedText}" />
        </StackPanel>
        <CheckBox x:Name="PlayerArtColorCheck" Content="再生バーの色を、再生中の曲のジャケットに合わせる" Margin="0,12,0,0"
                  Checked="PlayerArtColor_Changed" Unchecked="PlayerArtColor_Changed"
                  ToolTip="表示しているジャケット画像から色を取ります (色のために画像を取り直すことはしません)。白黒のジャケットのときはテーマカラーを使います。" />

        <TextBlock Text="Bandcamp のプロフィール" Style="{StaticResource Heading}" />
        <TextBlock Text="購入済みマークに使います。自分のプロフィールページの URL (またはユーザー名) を入力してください。&#10;公開されているコレクションを読み込みます (非公開にしている作品は判定できません)。"
                   Style="{StaticResource Note}" />
        <TextBox x:Name="ProfileBox" Padding="8,5" AutomationProperties.Name="プロフィール" TextChanged="ProfileBox_TextChanged" />
        <TextBlock x:Name="ProfileHint" Margin="0,4,0,0" FontSize="12" Foreground="{StaticResource MutedText}" Text="例: https://bandcamp.com/ユーザー名" />

        <TextBlock Text="Bandcamp へのリクエスト間隔" Style="{StaticResource Heading}" />
        <TextBlock Text="間隔を短くすると速くなりますが、Bandcamp への負荷が増えます。1 秒未満にはできません。" Style="{StaticResource Note}" />
        <StackPanel Orientation="Horizontal">
            <TextBox x:Name="IntervalBox" Width="70" Padding="8,4" AutomationProperties.Name="リクエスト間隔" />
            <TextBlock Text="秒 (既定 2.5)" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{StaticResource SubTextBrush}" />
        </StackPanel>

        <TextBlock Text="キャッシュ" Style="{StaticResource Heading}" />
        <TextBlock Text="取得済みのページを保存し、同じページへの重複したリクエストを防ぎます。" Style="{StaticResource Note}" />
        <DockPanel>
            <Button x:Name="ClearCacheButton" DockPanel.Dock="Right" Content="キャッシュを削除" Click="ClearCache_Click" Style="{StaticResource PillButton}" />
            <TextBlock x:Name="CacheText" VerticalAlignment="Center" Foreground="{StaticResource MutedText}" TextWrapping="Wrap" />
        </DockPanel>

        <DockPanel Margin="0,28,0,0">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button x:Name="OkButton" Content="保存" IsDefault="True" Click="Ok_Click" MinWidth="96" Style="{StaticResource AccentPillButton}" />
                <Button Content="キャンセル" IsCancel="True" MinWidth="96" Margin="8,0,0,0" Style="{StaticResource PillButton}" />
            </StackPanel>
            <TextBlock x:Name="VersionText" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource DimTextBrush}" />
        </DockPanel>
    </StackPanel>
</Window>
